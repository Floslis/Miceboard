# ─────────────────────────────────────────────────────────────
# MicBoard – Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control!
# ─────────────────────────────────────────────────────────────

# GitHub Personal Access Token (classic or fine-grained)
# Required scopes: repo (read + write to your private data repo)
# Create at: https://github.com/settings/tokens/new
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub owner (your username or organisation)
VITE_GITHUB_OWNER=your-github-username

# Name of your PRIVATE data repository
VITE_DATA_REPO=micboard-data

# Branch to use in the data repo (default: main)
VITE_DATA_BRANCH=main

# How often the display pages poll for updates (milliseconds, default 8000)
VITE_POLL_INTERVAL=8000

# Admin password – used for the simple password login on the admin panel
# Generate a strong random string: openssl rand -hex 32
VITE_ADMIN_PASSWORD=change-me-to-something-secure

# Base path for GitHub Pages deployment
# Set to /your-repo-name/ when deploying to username.github.io/your-repo-name
# Leave as / when using a custom domain
VITE_BASE_PATH=/
